// The keyboard window as plasma-keyboard's main.qml builds it (same popup aliases), around KDE's real KeyboardPanel.
import QtQuick
import "file://@PK@/src/qml" as KDE

Window {
    id: root
    width: 1000
    height: 700
    visible: true
    color: "black"

    property var virtualKeyboardContext: null
    property alias panel: keyboardPanel
    property alias alternativeKeysPopupItem: keyboardPanel.alternativeKeysPopup
    property alias characterPopupItem: keyboardPanel.characterPopup
    property alias flickPreviewPopupItem: keyboardPanel.flickPreviewPopup
    property alias languagePopupItem: keyboardPanel.languagePopup

    KDE.KeyboardPanel {
        id: keyboardPanel
        hostWindow: root
        virtualKeyboardContext: root.virtualKeyboardContext
    }
}
