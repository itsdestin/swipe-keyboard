[Desktop Entry]
Type=Application
Name=Swipe Keyboard
Comment=English, Spanish, French and German swipe typing, completions and next-word suggestions; manually selected KDE Wayland input method
Exec=swipe-keyboard-flatpak
Icon=input-keyboard
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
X-KDE-StartupNotify=false
