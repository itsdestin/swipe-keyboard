          "sha256": "f0fa19c6845758ab08074a0cfa8b7aecb71c999ca73d62883bc25cc018c4e548"
        },
        {
          "type": "file",
          "dest": "wheelcache",
          "dest-filename": "torch-2.10.0+cpu-cp314-cp314-manylinux_2_28_x86_64.whl",
          "url": "https://download-r2.pytorch.org/whl/cpu/torch-2.10.0%2Bcpu-cp314-cp314-manylinux_2_28_x86_64.whl",
          "sha256": "aada8afc068add586464b2a55adb7cc9091eec55caf5320447204741cb6a0604"
        }
      ]
    }
  ]
}
