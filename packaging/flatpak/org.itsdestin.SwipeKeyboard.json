{
  "id": "org.itsdestin.SwipeKeyboard",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "swipe-keyboard-flatpak",
  "build-options": {
    "prefix": "/app",
    "env": {"CMAKE_BUILD_PARALLEL_LEVEL": "2", "MAKEFLAGS": "-j2"}
  },
  "finish-args": [
    "--socket=wayland",
    "--socket=inherit-wayland-socket",
    "--filesystem=xdg-run/swipekb:create",
    "--nofilesystem=xdg-config/kdeglobals",
    "--no-talk-name=com.canonical.AppMenu.Registrar",
    "--no-talk-name=org.kde.kconfig.notify",
    "--no-talk-name=org.kde.KGlobalSettings"
  ],
  "modules": [
    {
      "name": "qt6-virtualkeyboard",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DQT_DISABLE_RPATH=OFF", "-DCMAKE_INSTALL_LIBDIR=lib"],
      "sources": [{
        "type": "archive",
        "url": "https://download.qt.io/official_releases/qt/6.10/6.10.3/submodules/qtvirtualkeyboard-everywhere-src-6.10.3.tar.xz",
        "sha256": "3298e26dfa4fad2363e3dfb2b55079c54fc8115a4a040d9616e5619f095d8fb5"
      }]
    },
    {
      "name": "libplasma",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=OFF", "-DCMAKE_INSTALL_LIBDIR=lib"],
      "sources": [{
        "type": "archive",
        "url": "https://invent.kde.org/plasma/libplasma/-/archive/3992079c1036f18c78f8fdda78be3697b689071c/libplasma-3992079c1036f18c78f8fdda78be3697b689071c.tar.gz",
        "sha256": "c4eafeccfb6be592f4db7c157ccf55b7f43d5b208d089487bb91891a13d59bd6"
      }]
    },
    {
      "name": "plasma-keyboard",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=OFF", "-DCMAKE_INSTALL_LIBDIR=lib", "-DPLASMA_KEYBOARD_SOUNDS_ENABLED=OFF", "-DPLASMA_KEYBOARD_VIBRATION_ENABLED=OFF"],
      "sources": [{
        "type": "archive",
        "url": "https://invent.kde.org/plasma/plasma-keyboard/-/archive/e54f5a9d95de54c0147911de009dc12b2d711757/plasma-keyboard-e54f5a9d95de54c0147911de009dc12b2d711757.tar.gz",
        "sha256": "30c6770d68d7a2a3e0a34e843679a8c8b515142e05f49fb61049d76ad0375b4c"
      }, {
        "type": "patch",
        "path": "../../scripts/patches/plasma-prediction-policy.patch"
      }, {
        "type": "file",
        "path": "../../scripts/patches/backendpredictionpolicy.h",
        "dest": "src"
      }]
    },
    {
      "name": "googletest",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DBUILD_SHARED_LIBS=OFF", "-DCMAKE_INSTALL_LIBDIR=lib"],
      "sources": [{
        "type": "archive",
        "url": "https://github.com/google/googletest/archive/refs/tags/v1.17.0.tar.gz",
        "sha256": "65fab701d9829d38cb77c14acdc431d2108bfdbf8979e40eb8ae567edf10b27c"
      }]
    },
    {
      "name": "swipe-keyboard",
      "buildsystem": "simple",
      "build-commands": [
        "sh packaging/flatpak/build-swipe.sh",
        "install -d /app/share/licenses/qt6-virtualkeyboard /app/share/licenses/libplasma /app/share/licenses/plasma-keyboard",
        "cp -a source-licenses/qt6-virtualkeyboard/LICENSES /app/share/licenses/qt6-virtualkeyboard/",
        "cp source-licenses/qt6-virtualkeyboard/src/plugins/tcime/3rdparty/tcime/COPYING /app/share/licenses/qt6-virtualkeyboard/tcime-COPYING",
        "cp -a source-licenses/libplasma/LICENSES /app/share/licenses/libplasma/",
        "cp -a source-licenses/plasma-keyboard/LICENSES /app/share/licenses/plasma-keyboard/"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "swipe-source.tar.xz",
          "sha256": "0406f79211d076ea78c45cb8f12eee63beb52996bdf03e990b87f64a6aa7bf93"
        },
        {
          "type": "archive",
          "dest": "source-licenses/qt6-virtualkeyboard",
          "url": "https://download.qt.io/official_releases/qt/6.10/6.10.3/submodules/qtvirtualkeyboard-everywhere-src-6.10.3.tar.xz",
          "sha256": "3298e26dfa4fad2363e3dfb2b55079c54fc8115a4a040d9616e5619f095d8fb5"
        },
        {
          "type": "archive",
          "dest": "source-licenses/libplasma",
