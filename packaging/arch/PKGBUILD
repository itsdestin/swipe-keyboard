# Local build candidate only; no install hooks and no publication.
pkgname=swipe-keyboard
pkgver=0.5.1
pkgrel=1
pkgdesc='English, Spanish, French and German swipe typing, completions and next-word suggestions for Plasma Keyboard'
arch=('x86_64')
url='https://github.com/itsdestin/swipe-keyboard'
# WHY these licences (owner decision 2026-10-23: MIT where possible; each data file keeps its own, see REUSE.toml):
# engine, tools and launcher MIT; the keyboard add-on layers that plug into GPL code (Qt Virtual
# Keyboard plugin, Plasma 6.9 front end) GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL; AOSP word list Apache-2.0; FineWeb text ODC-By-1.0;
# Tatoeba sentences CC BY 2.0 France (SPDX lists only the Generic port, so the France terms are a custom file installed
# below); the swipe model MIT (trained on MIT-licensed swipe data; models trained and released by Destin Moss via
# youcoded.ai, 2026); the swear-word list CC-BY-4.0; the texting-word lists CC0-1.0.
license=('MIT' 'GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL'
         'Apache-2.0' 'ODC-By-1.0' 'CC-BY-4.0' 'CC0-1.0' 'custom:TATOEBA-CC-BY-2.0-FR.txt')
# WHY no upper bound and no hard qt6-virtualkeyboard: one package serves Plasma 6.7/6.8 (Qt Virtual Keyboard front end,
# whose plasma-keyboard already requires that library) and Plasma 6.9 (front end on KDE's rebuilt keyboard, which has no
# Qt Virtual Keyboard). The launcher picks the matching one. Kirigami: the 6.9 suggestion row uses its theme colours.
depends=('python' 'systemd' 'gnupg' 'pacman' 'plasma-keyboard>=6.7' 'qt6-declarative' 'kirigami' 'kwindowsystem' 'kconfig' 'qt6-tools')
optdepends=('qt6-virtualkeyboard: needed by the Plasma 6.7/6.8 front end (plasma-keyboard 6.7/6.8 already installs it)')
# Kirigami supplies the QML accent-colour probe exercised by native plugin tests.
makedepends=('cmake' 'ninja' 'gcc' 'kirigami' 'gtest')
# Real KConfigWatcher regression needs a fresh private session, never the host bus.
checkdepends=('dbus')
# Native library dependencies are supplemented from the actual staged ELF files.
# This source tarball is generated locally with scripts/package-source.sh.
source=("swipe-keyboard-$pkgver.tar.gz")
# Locally generated source: source provenance and input locks are inside the archive.
sha256sums=('SKIP')

build() {
  cd "$srcdir/swipe-keyboard-$pkgver"
  scripts/fetch-assets.sh
  cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DSWIPEKB_PACKAGE_VERSION="$pkgver-$pkgrel"
  cmake --build build
}

check() {
  cd "$srcdir/swipe-keyboard-$pkgver"
  # WHY -j: the tests are independent (each uses its own temporary folders and free ports; the one ordering
  # dependency, the language-oracle fixture, is declared to CTest) and ran one after another for about 7 minutes;
  # Fedora already runs the same tests in parallel in under 3.
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure -j"$(nproc)"
  python -m unittest discover -s tests/packaging -v
  python -m unittest discover -s tests/integration -v
}

package() {
  cd "$srcdir/swipe-keyboard-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  # WHY a packaged link instead of an install hook: automatic updates are on from install, and removing the package
  # removes the link. "sudo swipe-keyboard updates off" turns them off.
  install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../swipe-keyboard-update.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/swipe-keyboard-update.timer"
  python scripts/package-check.py "$pkgdir"
  _add_native_dependencies
}

_add_native_dependencies() {
  # WHY helper: makepkg evaluates dependency assignments inside package() while reading
  # metadata, before any ELF/provider exists. Only query providers during actual packaging.
  # WHY direct ELF needs: recursive ldd includes unrelated transitive libraries and
  # fakeroot's LD_PRELOAD. Fail the transaction if generation fails (not a process substitution).
  local generated dependency name existing
  generated=$(python scripts/arch-dependencies.py "$pkgdir") || return 1
  while IFS= read -r dependency; do
    name=${dependency%%[\<\>\=]*}
    local -a retained=()
    for existing in "${depends[@]}"; do
      [[ ${existing%%[\<\>\=]*} == "$name" ]] || retained+=("$existing")
    done
    depends=("${retained[@]}" "$dependency")
  done <<< "$generated"
}
