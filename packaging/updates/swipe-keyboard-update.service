[Unit]
Description=Swipe Keyboard: install a newer keyboard if one is published
Wants=network-online.target
After=network-online.target
# WHY a file and not "systemctl disable": a timer enabled by the package cannot be disabled, only masked; this file
# is what "sudo swipe-keyboard updates off" writes.
ConditionPathExists=!/etc/swipe-keyboard/auto-update-off

[Service]
Type=oneshot
# WHY -I: a root process must not pick up Python settings or modules from its environment or working directory.
ExecStart=/usr/bin/python3 -I /usr/share/swipe-keyboard/integration/update.py check
# WHY a limit: a hung download or package-manager lock must not hold the unit forever (it would never run again).
TimeoutStartSec=30min
# WHY low priority: an update must never make the desktop stutter.
Nice=19
IOSchedulingClass=idle
# WHY these limits: the updater talks to the internet as root. It needs to write the system (to install), but never
# your home folder or other programs' temporary files.
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
