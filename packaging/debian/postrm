# WHY: let systemd forget the removed update units (pacman and rpm do this through their own systemd hooks).
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
#DEBHELPER#
