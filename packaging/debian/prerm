# WHY: the daily update timer is switched on by a packaged link, not by systemd's helpers. On removal it must stop now,
# or it stays scheduled until the next boot and fires once at a service that is gone (seen on Kubuntu 26.10, card #502).
# Arch and Fedora get the same through their package managers' systemd hooks. Nothing here touches the keyboard itself.
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl stop swipe-keyboard-update.timer >/dev/null 2>&1 || true
fi
#DEBHELPER#
