[Desktop Entry]
Name=Swipe Keyboard
Comment=English swipe typing for Plasma Keyboard
Exec=swipe-keyboard launch
Type=Application
X-KDE-Wayland-VirtualKeyboard=true
Icon=input-keyboard-virtual
NoDisplay=true
