{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Latin swipe language pack v1",
  "type": "object",
  "required": ["schema", "id", "version", "language", "locales", "layouts", "modes", "scripts", "compatibility", "futoRevision", "executorchRevision", "modelRevision", "source", "textRulesVersion", "transformationVersion", "license", "encoderLicense", "assets"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "language": {"enum": ["es", "fr", "de"]},
    "compatibility": {"const": "swipekb-futo-v1"},
    "futoRevision": {"const": "1b13f2c85d6b347f6ea3fbc4b3aaf01fce42429a"},
    "executorchRevision": {"const": "0b0e2c5cdd67c8b4396a46ea1d1aa72ffb0128d7"},
    "modelRevision": {"const": "18328c3042b066952c0936b3771d492fe2ec289a"},
    "locales": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "layouts": {"type": "array", "minItems": 1, "items": {"enum": ["qwerty", "azerty", "qwertz"]}},
    "scripts": {"const": ["Latn"]},
    "modes": {"const": ["Latin"]},
    "source": {"type": "object", "required": ["url", "sha256"], "properties": {"url": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "textRulesVersion": {"const": "unicode-latin-v1"},
    "transformationVersion": {"enum": ["wordfreq-latin-v1", "wordfreq-latin-v2"]},
    "license": {"type": "object", "required": ["id", "path", "sha256", "attribution", "termsPath", "termsSha256"], "properties": {"id": {"const": "CC-BY-SA-4.0"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "termsPath": {"type": "string"}, "termsSha256": {"const": "cde7883b9050a1104f4ac19a1572aafd6e5d7323b68351aaf51fbf4beba54966"}, "attribution": {"type": "string", "minLength": 1}}},
    "encoderLicense": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "assets": {
      "type": "object", "required": ["encoder", "dictionary"], "additionalProperties": false,
      "properties": {
        "encoder": {"allOf": [{"$ref": "#/$defs/asset"}, {"required": ["metadataSha256"], "properties": {"compatibility": {"const": "layout-agnostic"}, "metadataSha256": {"$ref": "#/$defs/hash"}}}]},
        "dictionary": {"$ref": "#/$defs/asset"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset": {"type": "object", "required": ["path", "sha256", "size", "compatibility"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "size": {"type": "integer", "minimum": 1}, "compatibility": {"type": "string", "minLength": 1}}}
  }
}
