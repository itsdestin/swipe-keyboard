# swipekb-gaming-managed
# swipekb-gaming-version: @VERSION@
# WHY the two lines above: install.sh and uninstall.sh only overwrite or delete a unit file that carries them,
# so a file of yours with the same name is never touched.
[Unit]
Description=Swipe Keyboard Gaming Mode helper (attaches to Steam's keyboard on this device)
# WHY Wants and not Requires: if the engine is down the helper just does nothing and Steam's own keyboard keeps working.
Wants=swipekb-engine.service
After=swipekb-engine.service
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
# WHY the Flatpak app id and not a path: see swipekb-engine.service.
# WHY --die-with-parent (found in the SteamOS VM, M8): Flatpak puts the program in its own scope, outside this
# service, so without it stopping or restarting the service left the old copy running. Copies piled up (three
# helpers) and a new engine refused to start because "another is already running".
ExecStart=/usr/bin/flatpak run --die-with-parent --user --command=swipekb-helper org.itsdestin.SwipeKeyboard.GamingHelper
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
