# swipekb-gaming-managed
# swipekb-gaming-version: @VERSION@
# swipekb-gaming-unit-revision: 3
# WHY the two lines above: install.sh and uninstall.sh only overwrite or delete a unit file that carries them,
# so a file of yours with the same name is never touched.
[Unit]
Description=Swipe Keyboard Gaming Mode engine (word guessing; no network)
# WHY no start limit (review fix 5): "30 starts in 300 s" was used up after about 90 s of a crash loop, and the unit then stayed
# dead with nothing to say why. systemd waits longer between tries instead (3 s, growing to 2 minutes), so a program that cannot
# start costs almost nothing, and one that recovers (Steam updated, Flatpak reinstalled) comes back by itself.
StartLimitIntervalSec=0

[Service]
# WHY the Flatpak app id and not a path: a Flatpak update replaces the files this runs from, so a path would
# go stale; the app id always points at the current version.
# WHY no session settings: this starts at boot, before Gaming Mode exists (plan Section 6, M0 results).
# WHY --die-with-parent (found in the SteamOS VM, M8): Flatpak puts the program in its own scope, outside this
# service, so without it stopping or restarting the service left the old copy running. Copies piled up (three
# helpers) and a new engine refused to start because "another is already running".
ExecStart=/usr/bin/flatpak run --die-with-parent --user --command=swipekb-gamingd org.itsdestin.SwipeKeyboard
Restart=always
RestartSec=3
RestartSteps=6
RestartMaxDelaySec=120

[Install]
WantedBy=default.target
